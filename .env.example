# Web3Forms Delivery to williams.the.tech@gmail.com
# 1. In Vercel Project Settings -> Environment Variables, add:
#    WEB3FORMS_ACCESS_KEY=your_key_here
#    (or VITE_WEB3FORMS_ACCESS_KEY=your_key_here)
# 2. For local testing, copy this file to .env and set your key.
#    (.env is git-ignored and will NEVER be pushed to GitHub)

WEB3FORMS_ACCESS_KEY=
VITE_WEB3FORMS_ACCESS_KEY=

# Optional alternative: Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
